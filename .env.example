# Runs without a paid API. Hash embeddings + lexical reranking are DEMO baselines.
EKI_EMBEDDING=hash
EKI_RERANKER=lexical
EKI_GENERATOR=extractive
EKI_DATA_DIR=data/runtime
# For learned embeddings and reranking: pip install -e '.[neural]'
# EKI_EMBEDDING=fastembed
# EKI_RERANKER=fastembed
# EKI_GENERATOR=openai
# OPENAI_API_KEY=
# EKI_LLM_MODEL=gpt-4.1-mini
# Server-side token required for every data endpoint. Local bind is 127.0.0.1.
EKI_API_KEY=local-demo-change-me
# Optional external services (otherwise embedded Qdrant + bounded local TTL cache)
# EKI_QDRANT_URL=http://localhost:6333
# EKI_QDRANT_API_KEY=
# EKI_REDIS_URL=redis://localhost:6379/0
# Web imports disabled unless exact HTTPS host is listed. No redirects.
EKI_WEB_HOSTS=[]
# Optional Langfuse: install observability extra; payload capture is disabled.
EKI_LANGFUSE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
